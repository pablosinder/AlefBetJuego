 "038ce6a7": "בְּדִיּוּק!",
 "abba0fb1": "נָכוֹן מְאוֹד!",
 "bcdc5bc8": "אַתְּ כּוֹכֶבֶת!",
 "de11d1ec": "הִצְלַחְתְּ!",
 "a18f0fd2": "אֵיזוֹ חֲכָמָה!",
 "5ea57ec6": "וָאוּ! אֵיזֶה יֹפִי!",
 "a814a1f1": "אַתְּ גְּאוֹנָה!",
 "e9abca46": "נַסּוּ שׁוּב",
 "7a99f3e4": "לֹא נוֹרָא, נַסִּי שׁוּב!",
 "9cc6a718": "כִּמְעַט! עוֹד פַּעַם",
 "814f7bb9": "אַתְּ יְכוֹלָה!",
 "4a23f1bf": "בּוֹאִי נְנַסֶּה שׁוּב",
 "ab6fd23c": "עוֹד נִסָּיוֹן קָטָן!",
 "6a3d68bd": "שָׁלוֹשׁ בְּרֶצֶף! אַתְּ עַל הַגַּל!",
 "f6d442d5": "אֵין עָלַיִךְ!",
 "910e09e9": "אַתְּ פָּשׁוּט מַדְהִימָה!",
 "c5c38379": "סִיַּמְתֶּם! כׇּל הַכָּבוֹד!",
 "8d67a574": "סִיַּמְתְּ אֶת הַמִּשְׂחָק! אֵיזוֹ אַלּוּפָה!",
 "ad1a3ea4": "וָאוּ, סִיַּמְתְּ! אֲנִי כׇּל כָּךְ גֵּאָה בָּךְ!",
 "49d40073": "לַחֲצוּ עַל אוֹת כְּדֵי לִשְׁמֹעַ",
 "db1eae61": "בְּאֵיזוֹ אוֹת מַתְחִילָה הַמִּלָּה?",
 "e88bceb7": "הַקִּיפוּ כׇּל אוֹת",
 "86a9c368": "סַמְּנוּ אֶת הַתְּמוּנוֹת שֶׁבִּשְׁמָן יֵשׁ אֶת הָאוֹת",
 "a4c95e41": "בַּחֲרוּ אֶת הַתְּמוּנָה שֶׁמַּתְחִילָה בַּצְּלִיל",
 "811a7693": "עִבְרוּ עַל הָאוֹת בָּאֶצְבַּע",
 "aba3ccb7": "כִּמְעַט! כַּסּוּ עוֹד קְצָת מֵהָאוֹת",
 "82304f84": "נַסּוּ לִכְתֹּב בְּתוֹךְ הָאוֹת",
 "42cf4183": "לְאֵיזוֹ קְבוּצָה שַׁיֶּכֶת הַמִּלָּה?",
 "95a67707": "אֵיזוֹ אוֹת חֲסֵרָה בַּמִּלָּה?",
 "a042dd8d": "חַבְּרוּ כׇּל תְּמוּנָה לָאוֹת שֶׁבָּהּ הִיא מַתְחִילָה",
 "114b8562": "הָאוֹתִיּוֹת",
 "2c4745b7": "הָאוֹת הָרִאשׁוֹנָה",
