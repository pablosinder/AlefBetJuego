 "8c3c5e90": "תְּנוּעוֹת",
 "7f5b88ba": "כְּתִיבַת אוֹתִיּוֹת",
 "a99d9c3b": "חֶלְקֵי הַדִּבּוּר",
 "e69b449b": "הַשְׁלִימוּ אֶת הַמִּלָּה",
 "de05b389": "חַבְּרוּ בְּקַו",
 "e62daf1d": "תּוֹפְסִים אוֹתִיּוֹת",
 "e08951f2": "צִבְעוּ לְפִי הָאוֹת",
 "4d2655d7": "אֵיפֹה הַצְּלִיל?",
 "016c48dd": "מַתְחִילָה אוֹ מִסְתַּיֶּמֶת",
 "e2f4f481": "שׁוֹמְעִים אוֹ לֹא?",
 "8eb80507": "מְמַיְּנִים לְסַלִּים",
 "b2de2bd0": "זָכָר וּנְקֵבָה",
