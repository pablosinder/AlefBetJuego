 "e920b8f1": "שָׁחֹר",
 "f257eeb2": "אָפֹר",
 "fed2813d": "רֹאשׁ מִיָּמִין, קַו בַּאֲלַכְסוֹן, וְרֶגֶל מִשְּׂמֹאל.",
 "fff6a644": "גַּג, קִיר מִיָּמִין, וְרִצְפָּה עִם עָקֵב קָטָן.",
 "4452e5ce": "קַו אָרֹךְ מִלְמַעְלָה לְמַטָּה, וְרֶגֶל קְטַנָּה לְצַד שְׂמֹאל.",
 "e888a035": "גַּג רָחָב, וְרֶגֶל אֲרֻכָּה בְּצַד יָמִין.",
 "fc3f5681": "כְּמוֹ דָּלֶת, וְרֶגֶל קְטַנָּה בְּצַד שְׂמֹאל שֶׁלֹּא נוֹגַעַת בַּגַּג.",
 "1cc2bb20": "קַו יָשָׁר וְאָרֹךְ, עִם רֹאשׁ קָטָן לְמַעְלָה.",
 "1e8dd3e3": "קַו יָשָׁר, וְעָלָיו כּוֹבַע קָטָן.",
 "490359db": "גַּג, וּשְׁתֵּי רַגְלַיִם אֲרֻכּוֹת.",
 "316e815d": "עֲגֻלָּה מִלְּמַטָּה, וּפְתוּחָה לְמַעְלָה.",
 "544e6d13": "הָאוֹת הַקְּטַנָּה בְּיוֹתֵר, כְּמוֹ נְקֻדָּה עִם זָנָב.",
 "14580c7d": "כְּמוֹ חֲצִי עִגּוּל, פְּתוּחָה לְצַד שְׂמֹאל.",
 "81aa103c": "רֹאשׁ שֶׁעוֹלֶה לְמַעְלָה, מֵעַל כׇּל הָאוֹתִיּוֹת.",
 "9e7e8d09": "אַף קָטָן לְמַעְלָה, וּפְתוּחָה קְצָת לְמַטָּה.",
 "d7279b64": "צָרָה, עִם רִצְפָּה קְטַנָּה.",
 "8ae95544": "עִגּוּל סָגוּר, עִם פִּנָּה קְטַנָּה לְמַעְלָה.",
 "19e2c269": "שְׁתֵּי זְרוֹעוֹת לְמַעְלָה, וְזָנָב לְמַטָּה.",
 "f4c44790": "כְּמוֹ כַּף, עִם לָשׁוֹן קְטַנָּה בִּפְנִים.",
 "cb53789b": "זְרוֹעַ קְטַנָּה מִיָּמִין, קַו בַּאֲלַכְסוֹן, וְרִצְפָּה.",
 "eaca7036": "גַּג, וְרֶגֶל אֲרֻכָּה שֶׁיּוֹרֶדֶת מִתַּחַת לַשּׁוּרָה.",
 "bd0a0863": "כְּמוֹ דָּלֶת, אֲבָל בְּלִי פִּנָּה: הַגַּג עָגֹל.",
 "d0e389a8": "שָׁלוֹשׁ זְרוֹעוֹת לְמַעְלָה, וְרִצְפָּה לְמַטָּה.",
 "b25a24e1": "כְּמוֹ חֵית, עִם רֶגֶל קְטַנָּה שֶׁבּוֹעֶטֶת שְׂמֹאלָה.",
 "3dba3c34": "כְּמוֹ רֵישׁ, אֲבָל הָרֶגֶל יוֹרֶדֶת מִתַּחַת לַשּׁוּרָה.",
 "94e8d900": "סְגוּרָה מִכׇּל הַצְּדָדִים, כְּמוֹ קֻפְסָה.",
 "ffd620db": "קַו אָרֹךְ שֶׁיּוֹרֵד מִתַּחַת לַשּׁוּרָה.",
 "25d34103": "כְּמוֹ פֵּא, וְהָרֶגֶל יוֹרֶדֶת מִתַּחַת לַשּׁוּרָה.",
 "a1a9a692": "כְּמוֹ צָדִי, וְהָרֶגֶל יוֹרֶדֶת מִתַּחַת לַשּׁוּרָה.",
 "4d3b2ac4": "שָׁלוֹם! בּוֹאוּ נְשַׂחֵק וְנִלְמַד אֶת הָאוֹתִיּוֹת.",
 "5a547958": "בַּחֲרוּ מִשְׂחָק",
 "3888da16": "כׇּל הַכָּבוֹד!",
 "4f69ab87": "מְצֻיָּן!",
 "82c5c1bc": "יוֹפִי!",
 "967ace7e": "אַלּוּפָה!",
 "93c36ccb": "נֶהְדָּר!",
 "b5950d05": "מְעֻלֶּה!",
 "2533fffe": "יָפֶה מְאוֹד!",
 "038ce6a7": "בְּדִיּוּק!",
 "abba0fb1": "נָכוֹן מְאוֹד!",
 "bcdc5bc8": "אַתְּ כּוֹכֶבֶת!",
 "de11d1ec": "הִצְלַחְתְּ!",
 "a18f0fd2": "אֵיזוֹ חֲכָמָה!",
 "5ea57ec6": "וָאוּ! אֵיזֶה יֹפִי!",
 "a814a1f1": "אַתְּ גְּאוֹנָה!",
 "e9abca46": "נַסּוּ שׁוּב",
 "7a99f3e4": "לֹא נוֹרָא, נַסִּי שׁוּב!",
 "9cc6a718": "כִּמְעַט! עוֹד פַּעַם",
 "814f7bb9": "אַתְּ יְכוֹלָה!",
 "4a23f1bf": "בּוֹאִי נְנַסֶּה שׁוּב",
 "ab6fd23c": "עוֹד נִסָּיוֹן קָטָן!",
 "6a3d68bd": "שָׁלוֹשׁ בְּרֶצֶף! אַתְּ עַל הַגַּל!",
 "f6d442d5": "אֵין עָלַיִךְ!",
 "910e09e9": "אַתְּ פָּשׁוּט מַדְהִימָה!",
 "c5c38379": "סִיַּמְתֶּם! כׇּל הַכָּבוֹד!",
 "8d67a574": "סִיַּמְתְּ אֶת הַמִּשְׂחָק! אֵיזוֹ אַלּוּפָה!",
 "ad1a3ea4": "וָאוּ, סִיַּמְתְּ! אֲנִי כׇּל כָּךְ גֵּאָה בָּךְ!",
 "49d40073": "לַחֲצוּ עַל אוֹת כְּדֵי לִשְׁמֹעַ",
 "db1eae61": "בְּאֵיזוֹ אוֹת מַתְחִילָה הַמִּלָּה?",
 "e88bceb7": "הַקִּיפוּ כׇּל אוֹת",
 "86a9c368": "סַמְּנוּ אֶת הַתְּמוּנוֹת שֶׁבִּשְׁמָן יֵשׁ אֶת הָאוֹת",
 "a4c95e41": "בַּחֲרוּ אֶת הַתְּמוּנָה שֶׁמַּתְחִילָה בַּצְּלִיל",
 "811a7693": "עִבְרוּ עַל הָאוֹת בָּאֶצְבַּע",
 "aba3ccb7": "כִּמְעַט! כַּסּוּ עוֹד קְצָת מֵהָאוֹת",
 "82304f84": "נַסּוּ לִכְתֹּב בְּתוֹךְ הָאוֹת",
 "42cf4183": "לְאֵיזוֹ קְבוּצָה שַׁיֶּכֶת הַמִּלָּה?",
 "95a67707": "אֵיזוֹ אוֹת חֲסֵרָה בַּמִּלָּה?",
 "a042dd8d": "חַבְּרוּ כׇּל תְּמוּנָה לָאוֹת שֶׁבָּהּ הִיא מַתְחִילָה",
 "5ad6e342": "תִּפְסוּ בַּסַּל אֶת הָאוֹתִיּוֹת שֶׁל הַמִּלָּה, לְפִי הַסֵּדֶר",
 "9e165f08": "בַּחֲרוּ צֶבַע, וְצִבְעוּ אֶת כׇּל הַחֲלָקִים עִם הָאוֹת שֶׁלּוֹ",
 "c9e3e323": "בְּאֵיזֶה עִגּוּל שׁוֹמְעִים אֶת הָאוֹת",
 "9df95e30": "סַמְּנוּ אֶת הַתְּמוּנוֹת שֶׁמַּתְחִילוֹת בָּאוֹת",
 "d0e8519a": "סַמְּנוּ אֶת הַתְּמוּנוֹת שֶׁמִּסְתַּיְּמוֹת בָּאוֹת",
 "f1bc5c18": "לַחֲצוּ עַל כׇּל תְּמוּנָה וְהַקְשִׁיבוּ. סַמְּנוּ אִם שׁוֹמְעִים אֶת הָאוֹת",
 "2bd0b2b4": "שִׂימוּ כׇּל תְּמוּנָה בַּסַּל שֶׁל הָאוֹת שֶׁבָּהּ הִיא מַתְחִילָה",
 "9dd5587c": "שִׂימוּ כׇּל תְּמוּנָה בַּסַּל שֶׁל הָאוֹת שֶׁבָּהּ הִיא מִסְתַּיֶּמֶת",
 "9122418d": "בְּדֶרֶךְ כְּלָל, הָאוֹת ה בְּסוֹף הַמִּלָּה מְצַיֶּנֶת נְקֵבָה",
 "84b63aef": "מִי הַנְּקֵבָה? בַּחֲרוּ אֶת הַמִּלָּה הַמַּתְאִימָה",
 "d1f3b5b8": "עַכְשָׁו לַחֲצוּ עַל הָאוֹת ה בְּסוֹף הַמִּלָּה",
 "079388e2": "קִרְאוּ בִּשְׁלַבִּים: לַחֲצוּ עַל כׇּל חֵלֶק, מִיָּמִין לִשְׂמֹאל",
 "d39db790": "אֵיזוֹ תְּמוּנָה מַתְאִימָה לַמִּלָּה?",
 "923b52fe": "בְּנוּ אֶת הַמִּלָּה: לַחֲצוּ עַל הַחֲלָקִים לְפִי הַסֵּדֶר",
 "22a78c24": "עִזְרוּ לָעַכְבָּר לְהַגִּיעַ לַגְּבִינָה. עוֹבְרִים רַק בִּתְמוּנוֹת שֶׁמַּתְחִילוֹת בָּאוֹת",
 "b6a751be": "עִזְרוּ לָעַכְבָּר לְהַגִּיעַ לַגְּבִינָה. עוֹבְרִים רַק בִּתְמוּנוֹת שֶׁמִּסְתַּיְּמוֹת בָּאוֹת",
 "3c8b96f2": "בַּחֲרוּ אוֹת, וּבוֹאוּ נִלְמַד אוֹתָהּ",
